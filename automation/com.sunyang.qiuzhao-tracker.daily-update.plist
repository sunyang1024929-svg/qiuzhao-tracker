<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sunyang.qiuzhao-tracker.daily-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/sunyangsunshine/qiuzhao-tracker/scripts/run-daily-update.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/sunyangsunshine/qiuzhao-tracker</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/sunyangsunshine/Library/Logs/qiuzhao-tracker/daily-update.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sunyangsunshine/Library/Logs/qiuzhao-tracker/daily-update-error.log</string>
</dict>
</plist>
